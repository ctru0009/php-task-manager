# Copy to .env before running docker compose (the application refuses to start
# without these variables). The values below match the MySQL container created
# by docker-compose.yml. If .env is missing, docker compose and the application
# both fail with a clear error instead of falling back to defaults.
DB_HOST=db
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=rootpass

# Set to 1 when the application is served over HTTPS, so the session cookie
# carries the Secure attribute. Keep 0 for plain http on localhost, otherwise
# the browser would not send the cookie at all.
SESSION_COOKIE_SECURE=0
